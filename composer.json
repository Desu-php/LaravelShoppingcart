{
    "name": "desu-php/shoppingcart",
    "description": "Session and database shopping carts for Laravel, with discounts, taxes and multiple instances.",
    "keywords": [
        "laravel",
        "shoppingcart",
        "cart",
        "ecommerce"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Rob Gloudemans",
            "email": "info@robgloudemans.nl",
            "homepage": "http://robgloudemans.nl/"
        },
        {
            "name": "Patrick Henninger",
            "email": "privat@skyraptor.eu",
            "homepage": "https://skyraptor.eu/"
        }
    ],
    "require": {
        "php": ">=7.0",
        "illuminate/support": "5.4.*||5.5.*||5.6.*||5.7.*||5.8.*||^6.0||^7.0||^8.0||^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/session": "5.4.*||5.5.*||5.6.*||5.7.*||5.8.*||^6.0||^7.0||^8.0||^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/events": "5.4.*||5.5.*||5.6.*||5.7.*||5.8.*||^6.0||^7.0||^8.0||^9.0||^10.0||^11.0||^12.0||^13.0",
        "nesbot/carbon": "~1.20||^1.26.3||^2.0||^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^6.5||^7.5||^8.5||^9.6||^10.5||^11.5",
        "mockery/mockery": "^1.0",
        "orchestra/testbench": "^3.4||^4.0||^5.0||^6.0||^7.0||^8.0||^9.0||^10.0||^11.0"
    },
    "autoload": {
        "psr-4": {
            "Gloudemans\\Shoppingcart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gloudemans\\Tests\\Shoppingcart\\": "tests/"
        }
    },
    "suggest": {
        "illuminate/database": "Required for store(), restore(), merge(), erase() and Eloquent model associations; use the same major as Laravel."
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Gloudemans\\Shoppingcart\\ShoppingcartServiceProvider"
            ],
            "aliases": {
                "ShoppingCart": "Gloudemans\\Shoppingcart\\Facades\\Cart"
            }
        }
    },
    "type": "library",
    "homepage": "https://github.com/Desu-php/LaravelShoppingcart",
    "support": {
        "source": "https://github.com/Desu-php/LaravelShoppingcart",
        "issues": "https://github.com/Desu-php/LaravelShoppingcart/issues"
    },
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit",
            "@php vendor/bin/phpunit integration/PublishingTest.php"
        ],
        "test:pgsql": "@php vendor/bin/phpunit integration/PostgresTest.php"
    }
}
